# Local development template. In Replit, store secrets in Tools > Secrets.
SESSION_SECRET=replace-with-a-long-random-value
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=sqlite:///./solvyn.db
# Optional: comma-separated origins for a separately hosted client.
CORS_ORIGINS=
# Optional override; the existing public client ID is used by default.
GOOGLE_CLIENT_ID=
